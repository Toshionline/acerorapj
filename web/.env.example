# supabase start / supabase status で表示される値を貼る (ローカル既定値は下記)
VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_ANON_KEY=<supabase status の ANON_KEY>

# デモアカウント即ログイン用のパスワード。バンドルに入るので公開環境では
# 推測困難な値にし、seed 済み auth.users のパスワードも同じ値に更新する。
# 未設定の本番ビルドではデモログインボタンが出ない (ローカルは officerelay に fallback)。
# VITE_DEMO_PASSWORD=
